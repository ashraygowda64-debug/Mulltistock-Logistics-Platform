# MultiStock Environment Variables
# Copy this file to .env and fill in your actual values

# Email Configuration (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# For Gmail App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Enable 2-Factor Authentication first
# 3. Generate app password for "Mail"
# 4. Copy the 16-character password here (no spaces)

# Example:
# EMAIL_HOST_USER=multistock@gmail.com
# EMAIL_HOST_PASSWORD=abcdefghijklmnop

# Production Email (Optional - for SendGrid/AWS SES)
# SENDGRID_API_KEY=your-sendgrid-api-key
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret

# Database (if using PostgreSQL/MySQL in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/multistock

# Security
# SECRET_KEY=your-secret-key-here
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
